struct Point {
  x: i32,
  y: i32,
}

// struct member used directly in a return expression
export fn sum_point(): i32 {
  let p: Point = { x = 3, y = 4 };
  return p.x + p.y;
}

// struct member used in a comparison condition
export fn clamp_to_positive(): i32 {
  let p: Point = { x = 5, y = 2 };
  if (p.x > p.y) {
    return p.x - p.y;
  }
  return 0;
}

// struct member write-back then read in arithmetic
export fn swap_and_sum(): i32 {
  let p: Point = { x = 10, y = 20 };
  let tmp: i32 = p.x;
  p.x = p.y;
  p.y = tmp;
  return p.x + p.y;
}

// struct member used in a while-loop condition
export fn count_down(): i32 {
  let p: Point = { x = 3, y = 0 };
  while (p.x) {
    p.y = p.y + 1;
    p.x = p.x - 1;
  }
  return p.y;
}

// global struct: members accessed via memory load + offset
let origin: Point = {
  x = 0,
  y = 0,
};

export fn squared_dist(px: i32, py: i32): i32 {
  let dx: i32 = px - origin.x;
  let dy: i32 = py - origin.y;
  return dx * dx + dy * dy;
}

export fn _start(): i32 {
  return sum_point() + clamp_to_positive() + swap_and_sum() + count_down() + squared_dist(3, 4);
}
