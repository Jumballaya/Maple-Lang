import add from "./math.maple"

struct Pair {
  left: i32,
  right: i32,
}

fn Pair.sum(p)(): i32 {
  return p.left + p.right;
}

fn Pair.scale(p)(factor: i32): i32 {
  return (p.left + p.right) * factor;
}

fn swap(a: i32, b: i32): (i32, i32) {
  return b, a;
}

fn divmod(n: i32, d: i32): (i32, i32) {
  return n / d, n % d;
}

fn passthrough_pair(x: i32, y: i32): (i32, i32) {
  return swap(x, y);
}

let base: Pair = {
  left = 2,
  right = 3,
};

let bonus: i32 = 6;
let runtime_pair: Pair = {
  left = bonus + 1,
  right = add(1, 2),
};

export fn _start(seed: i32): i32 {
  let nums: i32[] = [10, 20, 30, 40];
  let idx: i32 = 0;
  let total: i32 = add(base.left, base.right);
  let tweak: i32 = seed % 3;
  let weight: f32 = 1.0;

  // local struct: members used directly in arithmetic
  let lp: Pair = { left = 4, right = 1 };
  total = total + lp.left - lp.right;

  if (seed > 0) {
    total = total + nums[idx + 2];
  } else {
    total = total + nums[0];
  }

  for (let i: i32 = 0; i < 3; i = i + 1) {
    total = total + i;
  }

  while (total > 50) {
    total = total - 5;
    if (total < 40) {
      break;
    }
  }

  // switch behavior with explicit break/continue targets
  for (let s: i32 = 0; s < 5; s = s + 1) {
    switch (s) {
      case 0: {
        total = total + 11;
        continue;
      }
      case 1: {
        total = total + 5;
        break;
      }
      default: {
        total = total + s;
      }
    }
    total = total + 1;
  }

  tweak <<= 1;
  tweak |= 1;
  total += tweak;

  idx++;
  total = total + idx;
  idx--;

  // casting: scale total as f32, take half, cast back to i32
  let half: i32 = (total as f32 * 0.5) as i32;
  total += half;

  let flipped: i32 = ~tweak;
  if (!(seed == 0)) {
    total = total + (seed >> 1);
  }

  // if conditions normalize i32/f32 to wasm i32 condition values
  if (seed) {
    total = total + 2;
  }
  if (weight) {
    total = total + 3;
  }

  // type inference: no explicit type annotations needed
  let inferred_int = 7;
  let inferred_float = 2.0;
  let inferred_cast = inferred_int as f32 * inferred_float;
  total = total + inferred_int + (inferred_cast as i32);

  // 64-bit lanes: i64 add, u32 unsigned div, f64 remainder
  let acc64: i64 = seed as i64;
  acc64 = acc64 + (1000 as i64);
  total = total + (acc64 as i32);
  let uhi: u32 = (200 as u32) / (9 as u32);
  total = total + uhi as i32;
  let numer: f64 = 22.0;
  let denom: f64 = 7.0;
  total = total + (numer % denom) as i32;

  // strings: length of a string literal is accessible via .len
  let greeting: string = "hello";
  let inferred_str = "world!";
  total = total + greeting.len + inferred_str.len;

  // struct methods (locally defined): return type inferred from method signature
  let method_sum = base.sum();
  let method_scaled = base.scale(3);
  let local_sum = lp.sum();
  total = total + method_sum + method_scaled + local_sum + runtime_pair.sum();

  // 9B: multi-return + destructuring + discard + pass-through return
  let (sw_left, sw_right) = swap(total, tweak);
  let (q, r) = divmod(sw_left, 7);
  let (_, kept_right) = passthrough_pair(sw_left, sw_right);
  swap(1, 2);
  total = q + r + kept_right;

  return total + flipped + (-tweak);
}
