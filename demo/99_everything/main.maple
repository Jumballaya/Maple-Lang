import add from "./math.maple"

struct Pair {
  left: i32,
  right: i32,
}

let base: Pair = {
  left = 2,
  right = 3,
};

export fn _start(seed: i32): i32 {
  let nums: i32[] = [10, 20, 30, 40];
  let idx: i32 = 0;
  let total: i32 = add(base.left, base.right);
  let tweak: i32 = seed % 3;

  // local struct: members used directly in arithmetic (Phase 6B)
  let lp: Pair = { left = 4, right = 1 };
  total = total + lp.left - lp.right;

  if (seed > 0) {
    total = total + nums[idx + 2];
  } else {
    total = total + nums[0];
  }

  for (let i: i32 = 0; i < 3; i = i + 1) {
    total = total + i;
  }

  while (total > 50) {
    total = total - 5;
    if (total < 40) {
      break;
    }
  }

  tweak <<= 1;
  tweak |= 1;
  total += tweak;

  idx++;
  total = total + idx;
  idx--;

  // casting: scale total as f32, take half, cast back to i32 (Phase 6C)
  let half: i32 = (total as f32 * 0.5) as i32;
  total += half;

  let flipped: i32 = ~tweak;
  if (!(seed == 0)) {
    total = total + (seed >> 1);
  }

  return total + flipped + (-tweak);
}
