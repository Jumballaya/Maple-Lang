// Drop-in instrumented allocator: same public surface as "memory", swapped by
// import path. For a CORRECT program the two are semantically identical. For an
// incorrect one they diverge on purpose — "memory" traps (decision O7) while
// this module records the violation and continues, so a test can observe how
// many a run produced instead of losing the instance at the first one.

let HEAP_BASE: i32 = 0;
let heap_end: i32 = 0;
let free_head: i32 = 0;
let live_count: i32 = 0;
let live_bytes: i32 = 0;
let error_count: i32 = 0;

fn align8(x: i32): i32 {
  return (x + 7) & -8;
}

fn hdr_next(hdr: i32): i32 {
  return __load_i32(hdr);
}

fn hdr_set_next(hdr: i32, next: i32): void {
  __store_i32(hdr, next);
}

fn hdr_raw(hdr: i32): i32 {
  return __load_i32(hdr + 4);
}

fn hdr_size(hdr: i32): i32 {
  return hdr_raw(hdr) & -8;
}

fn hdr_is_alloc(hdr: i32): i32 {
  if ((hdr_raw(hdr) & 1) != 0) {
    return 1;
  }
  return 0;
}

fn hdr_write(hdr: i32, size: i32, alloc: i32): void {
  __store_i32(hdr + 4, (size & -8) | (alloc & 1));
  if ((alloc & 1) != 0) {
    __store_i32(hdr, 1296188748);
  }
}

fn is_live_heap(ptr: i32): i32 {
  if (ptr == 0) {
    return 0;
  }
  if (HEAP_BASE == 0) {
    return 0;
  }
  if ((ptr as u32) < ((HEAP_BASE + 8) as u32)) {
    return 0;
  }
  if ((ptr as u32) >= (heap_end as u32)) {
    return 0;
  }
  if ((ptr & 7) != 0) {
    return 0;
  }
  if (hdr_next(ptr - 8) != 1296188748) {
    return 0;
  }
  return hdr_is_alloc(ptr - 8);
}

// Make a use-after-free READ obviously wrong rather than plausibly stale.
fn poison(from: i32, to: i32): void {
  let cursor: i32 = from;
  while ((cursor as u32) < (to as u32)) {
    __store_i32(cursor, -559038737);
    cursor = cursor + 4;
  }
}

fn ensure_capacity(need_end: i32): i32 {
  let cur_pages: i32 = __memory_size();
  let need_pages: i32 = ((need_end as u32) >> 16) as i32;
  if ((need_end & 65535) != 0) {
    need_pages = need_pages + 1;
  }
  if (need_pages <= cur_pages) {
    return 1;
  }
  if (__memory_grow(need_pages - cur_pages) != -1) {
    return 1;
  }
  return 0;
}

fn split_if_big(hdr: i32, want: i32): i32 {
  let size: i32 = hdr_size(hdr);
  if (((size - want) as u32) >= (16 as u32)) {
    let tail_hdr: i32 = hdr + want;
    let tail_size: i32 = size - want;
    hdr_write(tail_hdr, tail_size, 0);
    hdr_write(hdr, want, 0);
    freelist_push(tail_hdr);
    return 1;
  }
  return 0;
}

export fn __heap_init(data_end: i32): void {
  HEAP_BASE = align8(data_end);
  heap_end = HEAP_BASE;
  free_head = 0;
  live_count = 0;
  live_bytes = 0;
  error_count = 0;
}

fn freelist_push(hdr: i32): void {
  hdr_set_next(hdr, free_head);
  free_head = hdr;
}

fn freelist_unlink(hdr: i32): void {
  let prev: i32 = 0;
  let cur: i32 = free_head;
  while (cur != 0) {
    if (cur == hdr) {
      if (prev == 0) {
        free_head = hdr_next(hdr);
      } else {
        hdr_set_next(prev, hdr_next(hdr));
      }
      return;
    }
    prev = cur;
    cur = hdr_next(cur);
  }
}

export fn malloc(n_bytes: i32): i32 {
  if (HEAP_BASE == 0) {
    __trap();
  }
  if ((n_bytes as u32) > (2147483624 as u32)) {
    return 0;
  }
  let n: i32 = n_bytes;
  if ((n_bytes as u32) < (1 as u32)) {
    n = 1;
  }
  let needed: i32 = align8(n) + 8;
  let cur: i32 = free_head;
  let size: i32 = 0;
  while (cur != 0) {
    size = hdr_size(cur);
    if ((size as u32) >= (needed as u32)) {
      split_if_big(cur, needed);
      freelist_unlink(cur);
      hdr_write(cur, hdr_size(cur), 1);
      live_count = live_count + 1;
      live_bytes = live_bytes + (hdr_size(cur) - 8);
      return cur + 8;
    }
    cur = hdr_next(cur);
  }

  let hdr: i32 = heap_end;
  let need_end: i32 = heap_end + needed;
  if ((need_end as u32) < (heap_end as u32)) {
    return 0;
  }
  if (ensure_capacity(need_end) == 0) {
    return 0;
  }
  heap_end = need_end;
  hdr_write(hdr, needed, 1);
  live_count = live_count + 1;
  live_bytes = live_bytes + (needed - 8);
  return hdr + 8;
}

export fn free(ptr: i32): void {
  if (ptr == 0) {
    return;
  }
  // The divergence from "memory": record and return instead of trapping.
  if (is_live_heap(ptr) == 0) {
    error_count = error_count + 1;
    return;
  }
  let hdr: i32 = ptr - 8;
  let size: i32 = hdr_size(hdr);
  live_count = live_count - 1;
  live_bytes = live_bytes - (size - 8);
  let next: i32 = hdr + size;
  if ((next as u32) < (heap_end as u32)) {
    if (hdr_is_alloc(next) == 0) {
      freelist_unlink(next);
      size = size + hdr_size(next);
    }
  }
  // Poison before the header and free-list writes, which reuse these words.
  poison(hdr + 8, hdr + size);
  hdr_write(hdr, size, 0);
  freelist_push(hdr);
  if (hdr + size == heap_end) {
    freelist_unlink(hdr);
    heap_end = hdr;
  }
}

export fn realloc(old: i32, new_size: i32): i32 {
  let next: i32 = malloc(new_size);
  if (next == 0) {
    return 0;
  }
  if (old == 0) {
    return next;
  }
  let copy_size: i32 = hdr_size(old - 8) - 8;
  if ((new_size as u32) < (copy_size as u32)) {
    copy_size = new_size;
  }
  __memory_copy(next, old, copy_size);
  free(old);
  return next;
}

// Payload bytes only: header overhead is `live_count * 8` if anyone wants it.
export fn heap_stats(): (i32, i32) {
  return live_count, live_bytes;
}

export fn heap_errors(): i32 {
  return error_count;
}
